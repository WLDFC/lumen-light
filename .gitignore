# 依赖包（可用 npm install 重装）
node_modules/

# 第三方工具及其模型文件（体积大，不会修改）
Real-ESRGAN/

# 用户存档数据（应用运行时会不断变化，不属于代码）
# 注意必须锚定根目录（/save/），否则会误伤源码目录 js/components/save/
/save/

# 实时保存恢复数据（画布变更自动写入的本地恢复槽位）
data/autosave/

# 网页桥接专用浏览器数据（profile/ 登录态与缓存、server.log，首次桥接自动生成）
data/webbridge/

# 用户资产库图片（图片工具栏「添加到资产」的运行时数据，内容哈希命名）
data/assets/

# 工作流编辑器节点布局 sidecar（运行时状态，按 workflow id 分键）
data/workflow-layouts.json

# 视频生成缓存（临时下载的视频文件，不属于代码）
data/videos/

# pi 运行时数据（会话文件、agent.log、控制台日志、pi 临时工作区）
data/pi/

# 根目录临时调试脚本（tmp_*.js 约定为一次性调试用，不进版本库）
/tmp_*.js

# pi 编码智能体完整包（421MB，开源发行时随 release 包分发，不进 git）
pi/

# MCP 服务器运行时（用户自挂的 MCP 虚拟环境，300MB 级，万级小文件；
# 随发行包分发、不入 git——与 pi/ 同策略）
/mcp/
